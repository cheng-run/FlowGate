# FlowGate 环境变量样例——复制为 .env 后按需填值。
# .env 已入 .gitignore：真实 key 永不进 git 历史（spec 故事 3/24）。
# 启动：uv run --env-file .env uvicorn app.main:app
# （uv 把本文件注入进程环境，代码只读 os.environ，因此不引 python-dotenv——零新依赖）

# 上游选择：fake（默认，离线回显，无 key 也能跑）| dashscope | kimi（真实上游）；
# 逗号表 = 顺序 fallback 链（A 先试、A 挂 B 接管），如 dashscope,kimi
FLOWGATE_PROVIDER=fake

# DashScope API key：FLOWGATE_PROVIDER 含 dashscope 时必需。
# 百炼控制台获取（bailian.console.aliyun.com），形如 sk-xxxxxxxx；缺失时启动即报错并指名此变量。
DASHSCOPE_API_KEY=

# OpenAI 兼容前缀：默认官方地址；接中转/代理时覆盖。删掉本行 = 用代码内置默认值。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Kimi API key：FLOWGATE_PROVIDER 含 kimi 时必需。缺失时启动即报错并指名此变量。
KIMI_API_KEY=

# Kimi OpenAI 兼容前缀：FLOWGATE_PROVIDER 含 kimi 时**同样必需**（无内置默认——Kimi 走
# 私有中转，真实地址只活在 .env，永不进 git）。形如 https://your-relay.example.com/v1；
# 值留空是**有意的**：占位假地址是非空值，照抄进 .env 会让启动检查形同虚设、
# 失败挪到运行期 DNS/401——空着缺了才响亮报错指名此变量。
KIMI_BASE_URL=
